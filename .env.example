# Zarak Portfolio - Environment Variables
# Copy this file to .env.local and fill in the values

# AI Provider API Key (Optional — Aimmyyy AI works offline, but this enables live Gemini 2.5 Flash)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Professional Email Service (Resend) - Recommended!
# 100% Free: 3,000 emails/month (100 emails/day)
# Get your free API key in 30 seconds at: https://resend.com
RESEND_API_KEY=

# Secondary Free Email Service (Optional Web3Forms backup)
# Get a free key at: https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Destination Email for Contact Form Submissions (Defaults to zarak.dev@gmail.com)
CONTACT_EMAIL=zarak.dev@gmail.com
